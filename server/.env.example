# Port to listen on (Render/Railway set this automatically)
PORT=8080

# Comma-separated list of allowed browser origins. Leave empty to allow any origin (local dev).
# Example: ALLOWED_ORIGINS=https://linkup.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=

# Optional TURN relay (needed for ~10-20% of users behind strict NATs / mobile carriers).
# TURN_URL may be a comma-separated list, e.g.
#   turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp,turns:global.relay.metered.ca:443
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
