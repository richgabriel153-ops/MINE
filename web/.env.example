# WebSocket URL of the signaling server (/server). Use wss:// in production.
NEXT_PUBLIC_SIGNALING_URL=ws://localhost:8080

# Supabase (server-side only; used by /api/report to store reports).
# Project Settings -> API. The service role key must NEVER be exposed with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
