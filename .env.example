# Paystack payment link opened by the "Go Pro" button (safe to expose)
NEXT_PUBLIC_PRO_PAYMENT_LINK=https://paystack.com/pay/your-link

# TEMPORARY: comma-separated Pro unlock codes, checked server-side by /api/unlock.
# Replace with a proper backend (per-buyer codes, Paystack webhook) later.
PRO_UNLOCK_CODES=CODE-ONE,CODE-TWO

# Optional: price shown on the Go Pro page, e.g. "₦5,000 one-time". Leave empty to hide.
NEXT_PUBLIC_PRO_PRICE_LABEL=
