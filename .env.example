# See SETUP.md for where each value comes from. Never commit real values.

# Supabase (accounts and online records)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Paystack (subscriptions + Pay Now links via subaccounts)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PLAN_MONTHLY=PLN_xxx
PAYSTACK_PLAN_YEARLY=PLN_xxx
# Optional
NEXT_PUBLIC_APP_URL=
PAYSTACK_PLATFORM_FEE_PERCENT=0

# Honoured early-supporter unlock codes (comma-separated, checked on the server)
PRO_UNLOCK_CODES=CODE-ONE,CODE-TWO

# Admin dashboard (/admin): emails allowed in, comma-separated
ADMIN_EMAILS=you@example.com

# InCeipt Assistant (AI, Pro) — Anthropic Claude API key
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional
AGENT_DAILY_LIMIT=40
AGENT_MODEL=
AGENT_EFFORT=low
AGENT_FALLBACKS=on
